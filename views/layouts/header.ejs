<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= (typeof title !== 'undefined' && title ? title + ' - ' : '') + (typeof appName !== 'undefined' ? appName : 'Vyapari') %></title>
    <meta name="description" content="Bullion trading ledger and accounting management application for Vyaparis.">
    <meta property="og:title" content="<%= (typeof title !== 'undefined' && title ? title + ' - ' : '') + (typeof appName !== 'undefined' ? appName : 'Vyapari') %>">
    <meta property="og:description" content="Bullion trading ledger and accounting management application for Vyaparis.">
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
    <header class="navbar">
        <a class="brand" href="/"><%= typeof appName !== 'undefined' ? appName : 'Vyapari' %></a>
        <nav>
            <a href="/">Home</a>
            <a href="/vyaparis">Vyapari</a>
            <a href="/products">Products</a>
            <a href="/transactions">Transactions</a>
        </nav>
        <form method="post" action="/logout">
            <button class="logout" type="submit">Logout (<%= user.name || 'Admin' %>)</button>
        </form>
        <button id="register-passkey" class="logout" type="button">Enable fingerprint login</button>
    </header>
    <script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@13.2.2/dist/bundle/index.js" crossorigin="anonymous"></script>
    <script>
    document.getElementById('register-passkey')?.addEventListener('click',async function(){this.disabled=true;try{const options=await (await fetch('/auth/passkey/register/options',{method:'POST'})).json();if(options.error)throw Error(options.error);const credential=await SimpleWebAuthnBrowser.startRegistration({optionsJSON:options});const result=await (await fetch('/auth/passkey/register/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(credential)})).json();if(result.error)throw Error(result.error);alert('Fingerprint login enabled on this device.');}catch(e){alert(e.message||'Could not enable fingerprint login.');}this.disabled=false;});
    </script>
<% } %>
<main class="<%= (typeof user !== 'undefined' && user) ? 'main container-fluid' : 'auth-main' %>">
    <% if (typeof flash !== 'undefined' && flash && flash.success) { %><div class="alert success"><%= flash.success %></div><% } %>
    <% if (typeof flash !== 'undefined' && flash && flash.error) { %><div class="alert error"><%= flash.error %></div><% } %>

