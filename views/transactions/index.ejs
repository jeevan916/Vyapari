<%- include('../layouts/header') %>

<div class="page-heading">
    <div>
        <span class="eyebrow">TRANSACTIONAL LEDGER</span>
        <h1>Trade Orders & Transactions</h1>
    </div>
    <div class="actions">
        <a class="btn primary" href="/transactions/create?type=maal-liya">+ Buy Order (Maal Liya)</a>
        <a class="btn" style="background:#fff8e6; border-color:#f4d068; color:#8a5300;" href="/transactions/create?type=maal-return">+ Sell Order (Fine Diya)</a>
        <a class="btn" href="/transactions/create">All Types</a>
    </div>
</div>

<!-- Quick Transaction Category Pills -->
<%
const currentType = filters.type || '';
const buildQuery = (newType) => {
    const p = new URLSearchParams();
    if (newType) p.set('type', newType);
    if (filters.vyapari_id) p.set('vyapari_id', filters.vyapari_id);
    if (filters.start_date) p.set('start_date', filters.start_date);
    if (filters.end_date) p.set('end_date', filters.end_date);
    if (filters.q) p.set('q', filters.q);
    const qs = p.toString();
    return qs ? '/transactions?' + qs : '/transactions';
};
%>
<div class="filter-pills no-print">
    <a class="filter-pill <%= !currentType ? 'active' : '' %>" href="<%= buildQuery('') %>">
        All Orders <span class="count"><%= counts.all %></span>
    </a>
    <a class="filter-pill <%= currentType === 'maal-liya' ? 'active' : '' %>" href="<%= buildQuery('maal-liya') %>">
        🟢 Maal / Fine Liya (Buy) <span class="count"><%= counts.liya %></span>
    </a>
    <a class="filter-pill <%= (currentType === 'maal-return' || currentType === 'fine-diya') ? 'active' : '' %>" href="<%= buildQuery('maal-return') %>">
        🟡 Fine / Maal Diya (Sell) <span class="count"><%= counts.diya %></span>
    </a>
    <a class="filter-pill <%= currentType === 'cash-diya' ? 'active' : '' %>" href="<%= buildQuery('cash-diya') %>">
        💵 Cash Paid <span class="count"><%= counts.cash %></span>
    </a>
    <a class="filter-pill <%= currentType === 'bank-payment-diya' ? 'active' : '' %>" href="<%= buildQuery('bank-payment-diya') %>">
        🏦 Bank Payment <span class="count"><%= counts.rtgs %></span>
    </a>
    <a class="filter-pill <%= currentType === 'rate-cut' ? 'active' : '' %>" href="<%= buildQuery('rate-cut') %>">
        📈 Rate Cuts <span class="count"><%= counts.rateCut %></span>
    </a>
    <% if (counts.opening > 0) { %>
    <a class="filter-pill <%= currentType === 'opening-balance' ? 'active' : '' %>" href="<%= buildQuery('opening-balance') %>">
        ⚖️ Opening Bal <span class="count"><%= counts.opening %></span>
    </a>
    <% } %>
</div>

<!-- Financial & Metal Volume KPIs for Filtered Results -->
<section class="summary-stat-grid">
    <div class="summary-stat-card">
        <span>Logged Trades</span>
        <strong><%= summary.count %> Orders</strong>
        <small><%= filters.type ? types[filters.type] || filters.type : 'All Categories' %></small>
    </div>
    <div class="summary-stat-card buy-card">
        <span>Buy (Liya) Volume</span>
        <strong style="color:#0369a1;"><%= weight3(summary.totalBuyNetWt) %> g</strong>
        <small>Total: ₹ <%= money(summary.totalBuyVal) %></small>
    </div>
    <div class="summary-stat-card sell-card">
        <span>Sell (Diya) Volume</span>
        <strong style="color:#b45309;"><%= weight3(summary.totalSellNetWt) %> g</strong>
        <small>Total: ₹ <%= money(summary.totalSellVal) %></small>
    </div>
    <div class="summary-stat-card gold-card">
        <span>Net Fine Gold (995)</span>
        <strong style="color:#854d0e;"><%= weight3(summary.totalFine995) %> g</strong>
        <small>Net Wt: <%= weight3(summary.totalNetWt) %> g</small>
    </div>
    <div class="summary-stat-card cash-card">
        <span>Net Cash Flow</span>
        <strong style="color:#15803d;">₹ <%= money(summary.totalCashAmt) %></strong>
        <small>Cash movements</small>
    </div>
    <div class="summary-stat-card rtgs-card">
        <span>Net RTGS Flow</span>
        <strong style="color:#6d28d9;">₹ <%= money(summary.totalRtgsAmt) %></strong>
        <small>Bank movements</small>
    </div>
</section>

<!-- Filter Form -->
<form class="panel grid cols-3" method="get" action="/transactions" style="margin-bottom:18px;">
    <label>Search Keyword
        <input name="q" placeholder="Trader, product, notes, rate..." value="<%= filters.q || '' %>">
    </label>
    <label>Order / Transaction Type
        <select name="type">
            <option value="">All Orders / Types</option>
            <option value="maal-liya" <%= (filters.type === 'maal-liya') ? 'selected' : '' %>>🟢 Maal / Fine Liya (Buy Order)</option>
            <option value="maal-return" <%= (filters.type === 'maal-return' || filters.type === 'fine-diya') ? 'selected' : '' %>>🟡 Fine / Maal Diya (Sell Order)</option>
            <option value="cash-diya" <%= (filters.type === 'cash-diya') ? 'selected' : '' %>>💵 Cash Diya (Cash Paid)</option>
            <option value="bank-payment-diya" <%= (filters.type === 'bank-payment-diya') ? 'selected' : '' %>>🏦 Bank Payment (RTGS/Cheque)</option>
            <option value="cash-rate-cut" <%= (filters.type === 'cash-rate-cut') ? 'selected' : '' %>>📈 Cash Rate Cut (Fine Jama)</option>
            <option value="bill-rate-cut" <%= (filters.type === 'bill-rate-cut') ? 'selected' : '' %>>📊 Bill Rate Cut (Fine Jama)</option>
            <option value="rate-cut" <%= (filters.type === 'rate-cut') ? 'selected' : '' %>>⚡ Any Rate Cut (Cash/Bill)</option>
            <option value="opening-balance" <%= (filters.type === 'opening-balance') ? 'selected' : '' %>>⚖️ Opening Balance</option>
        </select>
    </label>
    <label>Vyapari
        <select name="vyapari_id">
            <option value="">All Vyaparis</option>
            <% vyaparis.forEach(function(v) { %>
                <option value="<%= v.id %>" <%= String(filters.vyapari_id || '') === String(v.id) ? 'selected' : '' %>><%= v.vyapari_name %></option>
            <% }); %>
        </select>
    </label>
    <label>Date From <input type="date" name="start_date" value="<%= filters.start_date || '' %>"></label>
    <label>Date To <input type="date" name="end_date" value="<%= filters.end_date || '' %>"></label>
    <div class="form-actions" style="display:flex; gap:8px; align-items:flex-end;">
        <button class="btn primary" type="submit">Apply Filter</button>
        <a class="btn" href="/transactions">Reset</a>
    </div>
</form>

<!-- Master Transactional Ledger Table -->
<section class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Trade / Order</th>
                <th>Vyapari</th>
                <th>Product / Item</th>
                <th class="num">Net Wt</th>
                <th class="num">Purity</th>
                <th class="num">Rate / Bhav</th>
                <th class="num">Fine Gold (995)</th>
                <th class="num">Total Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <% if (transactions.length === 0) { %>
            <tr>
                <td colspan="10" style="text-align:center; padding: 32px 20px; color: #64748b;">
                    <div style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 6px;">No transactions match your filter</div>
                    <p style="margin: 0 0 12px; font-size: 0.85rem;">Try clearing the search filters or log a new trade order.</p>
                    <a class="btn primary" href="/transactions/create">Log Trade Order</a>
                    <a class="btn" href="/transactions" style="margin-left: 6px;">Clear Filters</a>
                </td>
            </tr>
        <% } %>
        <% transactions.forEach(function(row) { %>
            <%
            let badgeClass = 'opening';
            let badgeLabel = 'OTHER';
            if (row.transaction_type === 'maal-liya') {
                badgeClass = 'buy';
                badgeLabel = 'BUY (LIYA)';
            } else if (['maal-return', 'fine-diya'].includes(row.transaction_type)) {
                badgeClass = 'sell';
                badgeLabel = 'SELL (DIYA)';
            } else if (row.transaction_type === 'cash-diya') {
                badgeClass = 'cash';
                badgeLabel = 'CASH PAID';
            } else if (row.transaction_type === 'bank-payment-diya') {
                badgeClass = 'rtgs';
                badgeLabel = 'RTGS PAID';
            } else if (['cash-rate-cut', 'bill-rate-cut'].includes(row.transaction_type)) {
                badgeClass = 'ratecut';
                badgeLabel = row.transaction_type === 'cash-rate-cut' ? 'CASH RATE CUT' : 'BILL RATE CUT';
            } else if (row.transaction_type === 'opening-balance') {
                badgeClass = 'opening';
                badgeLabel = 'OPENING';
            }

            const netWt = Math.abs(Number(row.net_weight) || 0);
            const grossWt = Math.abs(Number(row.gross_weight) || 0);
            const fine995 = Math.abs(Number(row.balance_cat_995) || 0);
            const rateVal = Number(row.ten_gram_cash_995_rate || row.ten_gram_bill_995_rate || 0);
            const bhavVal = Number(row.cash_bhav || row.gst_bhav || 0);
            const totalAmt = Number(row.total_amount) || (Math.abs(Number(row.cash_amount) || 0) + Math.abs(Number(row.rtgs_amount) || 0));
            %>
            <tr>
                <td style="white-space:nowrap; font-weight:700; color:#334155;">
                    <%= row.transaction_date %>
                </td>
                <td>
                    <span class="trade-badge <%= badgeClass %>"><%= badgeLabel %></span>
                    <% if (row.notes) { %>
                        <small style="display:block; color:#64748b; font-size:0.68rem; margin-top:2px; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= row.notes %>">
                            <%= row.notes %>
                        </small>
                    <% } %>
                </td>
                <td>
                    <strong><%= row.vyapari_name %></strong>
                </td>
                <td>
                    <span style="color:#0f172a; font-weight:600;"><%= row.product_name || '-' %></span>
                </td>
                <td class="num">
                    <% if (netWt > 0) { %>
                        <strong><%= weight3(netWt) %> g</strong>
                        <% if (grossWt > 0 && grossWt !== netWt) { %>
                            <small style="display:block; color:#94a3b8; font-size:0.65rem;">Gr: <%= weight3(grossWt) %> g</small>
                        <% } %>
                    <% } else { %>
                        <span style="color:#94a3b8;">—</span>
                    <% } %>
                </td>
                <td class="num">
                    <% if (row.melting > 0) { %>
                        <strong style="color:#334155;"><%= Number(row.melting).toFixed(2) %>%</strong>
                        <% if (row.rate > 0) { %>
                            <small style="display:block; color:#b45309; font-size:0.65rem;">+<%= Number(row.rate).toFixed(2) %>% wstg</small>
                        <% } %>
                    <% } else { %>
                        <span style="color:#94a3b8;">—</span>
                    <% } %>
                </td>
                <td class="num">
                    <% if (rateVal > 0) { %>
                        <strong style="color:#0284c7;">₹ <%= money(rateVal) %></strong>
                        <small style="display:block; color:#64748b; font-size:0.65rem;">/10g (<%= row.ten_gram_cash_995_rate > 0 ? 'Cash' : 'Bill' %>)</small>
                    <% } else if (bhavVal > 0) { %>
                        <strong style="color:#0284c7;">₹ <%= money(bhavVal) %></strong>
                        <small style="display:block; color:#64748b; font-size:0.65rem;">/gram</small>
                    <% } else { %>
                        <span style="color:#94a3b8;">Khata (Metal)</span>
                    <% } %>
                </td>
                <td class="num">
                    <% if (fine995 > 0) { %>
                        <strong style="color:#854d0e;"><%= weight3(fine995) %> g</strong>
                        <% if (row.purity_999) { %>
                            <small style="display:block; color:#94a3b8; font-size:0.65rem;">999: <%= weight3(Math.abs(row.purity_999)) %> g</small>
                        <% } %>
                    <% } else { %>
                        <span style="color:#94a3b8;">—</span>
                    <% } %>
                </td>
                <td class="num">
                    <% if (totalAmt > 0) { %>
                        <strong style="color:#047857; font-size:0.92rem;">₹ <%= money(totalAmt) %></strong>
                        <% if (row.cash_amount && row.rtgs_amount) { %>
                            <small style="display:block; color:#64748b; font-size:0.62rem;">Cash: ₹ <%= money(Math.abs(row.cash_amount)) %> | RTGS: ₹ <%= money(Math.abs(row.rtgs_amount)) %></small>
                        <% } else if (row.cash_amount) { %>
                            <small style="display:block; color:#15803d; font-size:0.62rem;">Cash <%= row.cash_amount > 0 ? 'Due' : 'Paid' %></small>
                        <% } else if (row.rtgs_amount) { %>
                            <small style="display:block; color:#6d28d9; font-size:0.62rem;">RTGS <%= row.rtgs_amount > 0 ? 'Due' : 'Paid' %></small>
                        <% } %>
                    <% } else { %>
                        <span style="color:#94a3b8; font-weight:700;">0.00 (Pure Metal)</span>
                    <% } %>
                </td>
                <td class="actions" style="white-space:nowrap;">
                    <a class="btn" style="padding:4px 8px; font-size:0.75rem;" href="/ledger?vyapari_id=<%= row.vyapari_id %>">Ledger</a>
                    <a class="btn" style="padding:4px 8px; font-size:0.75rem;" href="/transactions/edit?id=<%= row.id %>">Edit</a>
                    <form method="post" action="/transactions/delete" style="display:inline;" onsubmit="return confirm('Delete this trade order transaction?');">
                        <input type="hidden" name="id" value="<%= row.id %>">
                        <button class="btn danger" style="padding:4px 8px; font-size:0.75rem;" type="submit">✕</button>
                    </form>
                </td>
            </tr>
        <% }); %>
        </tbody>
    </table>
</section>

<%- include('../layouts/footer') %>
