<%- include('../layouts/header') %>
<% const isEdit = Boolean(product && product.id); %>
<div class="page-heading">
    <div><span class="eyebrow">INVENTORY</span><h1><%= title %></h1></div>
</div>
<form class="panel grid cols-2" method="post" action="<%= isEdit ? '/products/update' : '/products/store' %>">
    <% if (isEdit) { %><input type="hidden" name="id" value="<%= product.id %>"><% } %>
    <label>Vyapari
        <select name="vyapari_id">
            <option value="">Common Product</option>
            <% vyaparis.forEach(function(v) { %>
                <option value="<%= v.id %>" <%= String(product.vyapari_id || selectedVyapariId || '') === String(v.id) ? 'selected' : '' %>><%= v.vyapari_name %></option>
            <% }); %>
        </select>
    </label>
    <label>Product Name <input name="product_name" required value="<%= product.product_name || '' %>"></label>
    <label>Purity <input type="number" step="0.001" name="purity" value="<%= product.purity ?? '0' %>"></label>
    <label>Rate <input type="number" step="0.001" name="rate" value="<%= product.rate ?? '0' %>"></label>
    <div class="form-actions" style="grid-column: 1 / -1;">
        <button class="btn primary" type="submit">Save</button>
        <a class="btn" href="/products">Cancel</a>
    </div>
</form>
<%- include('../layouts/footer') %>
